pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = "540191526881"
        AWS_REGION     = "us-east-1"
        ECR_REPO       = "backend"
        IMAGE_NAME     = "backend"
        GIT_REPO_NAME  = "CloudOPs"
        GIT_USER_NAME  = "CloudCodeOps"
        IMAGE_TAG      = "${BUILD_NUMBER}"

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        FULL_IMAGE   = "${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/CloudCodeOps/CloudOPs.git'
            }
        }

        stage('Check for CI Skip') {
            steps {
                script {
                    def lastAuthor = sh(script: "git log -1 --pretty=%an", returnStdout: true).trim()
                    def lastMsg    = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()

                    echo "Last commit author: ${lastAuthor}"
                    echo "Last commit message: ${lastMsg}"

                    if (lastMsg.contains('[skip ci]')) {
                        echo "Detected CI bot's own commit (skip ci tag found) — skipping rebuild."
                        currentBuild.result = 'NOT_BUILT'
                        error("Stopping: this build was triggered by the deployment-file commit.")
                    }
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('backend') {
                    sh '''
                        echo "Building Docker image..."

                        docker build \
                          -t ${IMAGE_NAME}:${IMAGE_TAG} .

                        echo "Image created:"
                        docker images | grep ${IMAGE_NAME}
                    '''
                }
            }
        }

        stage('ECR Image Pushing') {
            steps {
                sh '''
                    echo "Logging into ECR..."

                    aws ecr get-login-password \
                      --region ${AWS_REGION} \
                    | docker login \
                      --username AWS \
                      --password-stdin \
                      ${ECR_REGISTRY}

                    echo "Tagging image..."

                    docker tag \
                      ${IMAGE_NAME}:${IMAGE_TAG} \
                      ${FULL_IMAGE}

                    echo "Pushing image to ECR..."

                    docker push ${FULL_IMAGE}

                    echo "Image pushed successfully:"
                    echo ${FULL_IMAGE}
                '''
            }
        }

        stage('Update Deployment File') {
            steps {
                dir('kubernetes-files') {

                    withCredentials([
                        string(
                            credentialsId: 'my-git-pattoken',
                            variable: 'GIT_TOKEN'
                        )
                    ]) {

                        sh '''
                            echo "Configuring Git..."

                            git config user.email "shubhamturale.edu@gmail.com"
                            git config user.name "CloudCodeOps"

                            echo "Getting latest changes from GitHub..."

                            git pull --rebase origin main

                            echo "Updating Kubernetes deployment..."

                            sed -i "s|^[[:space:]]*image:.*|        image: ${FULL_IMAGE}|" backend-deployment.yaml

                            echo "New image:"
                            grep "image:" backend-deployment.yaml

                            git add backend-deployment.yaml

                            if git diff --cached --quiet; then
                                echo "No changes to commit."
                            else
                                git commit -m "Update backend image to ${IMAGE_TAG} [skip ci]"

                                for i in 1 2 3; do
                                    git push \
                                      https://${GIT_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                                      HEAD:main && break
                                    echo "Push failed, retrying after rebase..."
                                    git pull --rebase origin main
                                    sleep 2
                                done
                            fi
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "=========================================="
            echo "Backend CI/CD completed successfully!"
            echo "Image: ${FULL_IMAGE}"
            echo "Argo CD will deploy the new image."
            echo "=========================================="
        }

        failure {
            echo "Backend CI/CD pipeline failed."
        }
    }
}
